# Copy to /etc/meshgarden/watchdog.env, then:
#   sudo chown root:root /etc/meshgarden/watchdog.env
#   sudo chmod 0600 /etc/meshgarden/watchdog.env
#
# This file is read by meshgarden-watchdog.service (EnvironmentFile=) and by
# `sudo mgarden notify-test`. It is root-only because the ntfy topic URL is
# effectively a shared secret: anyone who knows it can read your alerts and
# publish to them. Never commit the real file.

# REQUIRED to receive alerts. Pick a long, unguessable topic name -- ntfy.sh
# topics are public to anyone who knows the name. Leave unset and the
# watchdog still runs and still power-cycles; it just cannot page you.
MESHGARDEN_NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic

# How long a fault must persist before alerting or power-cycling, in
# seconds. Must exceed a normal reconnect: the radio reboots (and so
# re-enumerates) whenever you change its config from the phone app.
#MESHGARDEN_WATCHDOG_GRACE_SECONDS=300

# Automatic USB power cycles allowed per day. 0 disables power-cycling
# entirely, leaving alert-only behavior. The cap exists so a hardware fault
# cannot loop on power-cycling the radio forever.
#MESHGARDEN_WATCHDOG_MAX_CYCLES_PER_DAY=3

# Minimum gap between two power cycles, in seconds. Give the radio time to
# boot and the daemon time to reconnect (its backoff is up to 300s) before
# concluding the cycle did not work.
#MESHGARDEN_WATCHDOG_CYCLE_COOLDOWN_SECONDS=900

# Which USB port to cycle. Find yours with `sudo uhubctl`: the hub location
# and the port whose entry names your radio. The hub must report "ppps"
# (per-port power switching) for this to work.
#MESHGARDEN_WATCHDOG_HUB=1-1
#MESHGARDEN_WATCHDOG_HUB_PORT=4
